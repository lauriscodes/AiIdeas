{
	"name": "frontend",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"preview": "node --env-file-if-exists=.env ./infra/preview.js",
		"analyze": "npx vite-bundle-visualizer",
		"typecheck": "react-router typegen && tsc",
		"lint": "eslint . --ext .ts,.tsx,.js,.jsx",
		"lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint-staged": "lint-staged --config infra/lint-staged.config.js",
		"pre-commit": "npm run lint-staged",
		"prepare": "husky",
		"storybook": "cross-env STORYBOOK=true storybook dev -p 6006",
		"build-storybook": "cross-env STORYBOOK=true storybook build",
		"generate:openapi": "node ./node_modules/dotenv-cli/cli.js -e .env -- openapi-ts",
		"test:unit": "vitest run",
		"build:integration": "cross-env ENABLE_MOCKS=true react-router build",
		"serve:integration": "bun --bun run mocky-balboa-react-router -p 5173",
		"test:integration": "playwright test --project=integration",
		"test:e2e": "playwright test --project=e2e"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hookform/resolvers": "^7.0.6",
		"@react-router/node": "^8.5.1",
		"@react-router/serve": "^8.5.1",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-virtual": "^3.14.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^27.1.1",
		"i18next-browser-languagedetector": "^8.3.0",
		"i18next-fetch-backend": "^8.0.0",
		"isbot": "^5.2.3",
		"isomorphic-dompurify": "^4.7.0",
		"lucide-react": "^1.72.0",
		"nuqs": "^2.10.3",
		"pretty-cache-header": "^1.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.92.0",
		"react-i18next": "^18.0.1",
		"react-router": "^8.5.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"remix-i18next": "^8.0.0",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@faker-js/faker": "^10.6.0",
		"@hey-api/openapi-ts": "^0.99.0",
		"@mocky-balboa/playwright": "^2.0.2",
		"@mocky-balboa/react-router": "^1.1.4",
		"@playwright/test": "^1.65.0",
		"@react-router/dev": "^8.5.1",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/react-vite": "^10.6.7",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/eslint-plugin": "^1.6.28",
		"@vitest/ui": "^5.1.0",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.10",
		"dotenv-cli": "^11.1.0",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-check-file": "^3.3.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-storybook": "^10.6.7",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"storybook": "^10.6.7",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vite-bundle-analyzer": "^1.3.9",
		"vitest": "^5.1.0"
	}
}
