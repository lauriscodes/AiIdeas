{
	"name": "backend",
	"version": "1.0.0",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"build": "bun build ./src/index.ts --outdir ./dist --target bun",
		"seed": "bun run src/db/seed.ts",
		"migrate": "bun --bun run drizzle-kit migrate",
		"generate": "bun --bun run drizzle-kit generate",
		"studio": "bun --bun run drizzle-kit studio",
		"db:prepare": "bun run migrate && bun run seed",
		"setup": "bun run setup.js"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@libsql/client": "^0.18.0",
		"@scalar/hono-api-reference": "^0.12.20",
		"bcryptjs": "^3.0.3",
		"dotenv": "^18.0.10",
		"dotenv-expand": "^1000.0.0",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.18",
		"hono-pino": "^0.10.3",
		"jsonwebtoken": "^9.0.3",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"stoker": "^2.0.1",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@types/bun": "latest",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-plugin-format": "^2.0.1",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3"
	}
}
